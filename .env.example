# Traffo Environment Variables
# Copy this to .env (at repo root or backend/.env) and fill in your keys

# REQUIRED: Free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# RECOMMENDED: Free 2,500 req/day at https://developer.tomtom.com/
# Powers live Traffic Flow v4 speeds/closures and Incident Details v5 feeds
TOMTOM_API_KEY=your_tomtom_api_key_here
